# =============================================================================
# voice-rooms Docker 部署配置
# 用法：cp .env.example .env，改完下面三项后 docker compose up -d --build
# =============================================================================

# ① 对外访问源（含协议）。用于 SvelteKit ORIGIN 与 WS 跨源校验，
#    必须与你在外部 Caddy 里配置的站点域名一致
PUBLIC_ORIGIN=https://voice.example.com

# ② 浏览器连接 LiveKit 的信令地址：wss + 同一域名 + /livekit 路径
#    （外部 Caddy 的 handle_path /livekit/* 会转发到容器信令端口）
LIVEKIT_URL=wss://voice.example.com/livekit

# ③ LiveKit API 密钥对（livekit 与 Go 后端共享）。生成方法（服务器上执行）：
#      openssl rand -hex 8    # LIVEKIT_KEY
#      openssl rand -hex 24   # LIVEKIT_SECRET
#    不设密钥 compose 会拒绝启动（防裸密钥上线）
LIVEKIT_KEY=CHANGE_ME_KEY
LIVEKIT_SECRET=CHANGE_ME_SECRET_AT_LEAST_32_CHARS

# 时区（日志与房间时间戳显示用，可选）
TZ=Asia/Shanghai

# ---- 可选开关（用到了取消注释）----
# 开放注册/登录系统
#AUTH_REGISTER_ENABLED=true
# 创建房间需要登录
#CREATE_REQUIRE_ACCOUNT=true
# 注册需邮箱验证码（需同时配置下面的 SMTP 发信）
#MAIL_VERIFY_ENABLED=true
#MAIL_SMTP_HOST=smtp.example.com
#MAIL_SMTP_PORT=465
#MAIL_SMTP_USER=
#MAIL_SMTP_PASS=
